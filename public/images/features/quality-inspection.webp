<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d0d0d;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="green1" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#16A34A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#22C55E;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="url(#bg1)"/>
  
  <!-- Subtle grid pattern -->
  <g opacity="0.1">
    <line x1="0" y1="100" x2="800" y2="100" stroke="#16A34A" stroke-width="0.5"/>
    <line x1="0" y1="200" x2="800" y2="200" stroke="#16A34A" stroke-width="0.5"/>
    <line x1="0" y1="300" x2="800" y2="300" stroke="#16A34A" stroke-width="0.5"/>
    <line x1="0" y1="400" x2="800" y2="400" stroke="#16A34A" stroke-width="0.5"/>
    <line x1="0" y1="500" x2="800" y2="500" stroke="#16A34A" stroke-width="0.5"/>
  </g>
  
  <!-- Laboratory/Testing icon -->
  <g transform="translate(300, 200)">
    <!-- Flask/Beaker -->
    <path d="M 150 50 L 150 120 L 100 200 L 250 200 L 200 120 L 200 50 Z" 
          fill="none" stroke="url(#green1)" stroke-width="4"/>
    <rect x="140" y="30" width="70" height="20" rx="3" fill="none" stroke="url(#green1)" stroke-width="4"/>
    <!-- Liquid -->
    <path d="M 110 180 L 150 140 L 240 180 L 240 200 L 110 200 Z" 
          fill="#16A34A" opacity="0.3"/>
    <!-- Bubbles -->
    <circle cx="150" cy="160" r="8" fill="none" stroke="#22C55E" stroke-width="2"/>
    <circle cx="180" cy="170" r="5" fill="none" stroke="#22C55E" stroke-width="2"/>
    <circle cx="130" cy="175" r="6" fill="none" stroke="#22C55E" stroke-width="2"/>
  </g>
  
  <!-- Text -->
  <text x="400" y="480" font-family="Arial, sans-serif" font-size="32" font-weight="bold" 
        fill="white" text-anchor="middle">Quality Testing</text>
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="18" 
        fill="#22C55E" text-anchor="middle">Precision & Excellence</text>
</svg>