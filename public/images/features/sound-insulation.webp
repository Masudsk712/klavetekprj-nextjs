<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg5" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d0d0d;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="green5" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#16A34A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#22C55E;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="url(#bg5)"/>
  
  <!-- Sound waves illustration -->
  <g transform="translate(400, 300)">
    <!-- Outer sound waves (noise being blocked) -->
    <g opacity="0.3">
      <circle cx="0" cy="0" r="180" fill="none" stroke="#EF4444" stroke-width="2" stroke-dasharray="10,5"/>
      <circle cx="0" cy="0" r="150" fill="none" stroke="#EF4444" stroke-width="2" stroke-dasharray="10,5"/>
      <circle cx="0" cy="0" r="120" fill="none" stroke="#EF4444" stroke-width="2" stroke-dasharray="10,5"/>
    </g>
    
    <!-- Building/Room icon -->
    <g transform="translate(-60, -70)">
      <rect x="0" y="50" width="120" height="100" fill="none" stroke="url(#green5)" stroke-width="3"/>
      <!-- Roof -->
      <polygon points="0,50 60,10 120,50" fill="none" stroke="url(#green5)" stroke-width="3"/>
      <!-- Window -->
      <rect x="20" y="80" width="35" height="35" fill="#16A34A" opacity="0.4" stroke="#22C55E" stroke-width="2"/>
      <rect x="65" y="80" width="35" height="35" fill="#16A34A" opacity="0.4" stroke="#22C55E" stroke-width="2"/>
      <!-- Door -->
      <rect x="45" y="130" width="30" height="20" fill="none" stroke="url(#green5)" stroke-width="2"/>
    </g>
    
    <!-- Inner quiet zone -->
    <circle cx="0" cy="0" r="80" fill="none" stroke="#22C55E" stroke-width="3" opacity="0.6"/>
    
    <!-- Sound absorption icons -->
    <g opacity="0.8">
      <path d="M -30 -20 L -20 -10 L -30 0" fill="none" stroke="#22C55E" stroke-width="2"/>
      <path d="M 30 -20 L 20 -10 L 30 0" fill="none" stroke="#22C55E" stroke-width="2"/>
    </g>
    
    <!-- Peaceful indicator -->
    <text x="0" y="120" font-family="Arial" font-size="18" fill="#22C55E" text-anchor="middle" font-weight="bold">Peaceful</text>
  </g>
  
  <!-- Text -->
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="32" font-weight="bold" 
        fill="white" text-anchor="middle">Sound Insulation</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" 
        fill="#22C55E" text-anchor="middle">Quiet & Comfortable Spaces</text>
</svg>