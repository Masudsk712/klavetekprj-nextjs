<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg6" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d0d0d;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="green6" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#16A34A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#22C55E;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="fireGradient" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" style="stop-color:#EF4444;stop-opacity:0.9" />
      <stop offset="50%" style="stop-color:#F59E0B;stop-opacity:0.7" />
      <stop offset="100%" style="stop-color:#FCD34D;stop-opacity:0.5" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="url(#bg6)"/>
  
  <!-- Fire resistance illustration -->
  <g transform="translate(250, 200)">
    <!-- Fire/flames on left side -->
    <g transform="translate(50, 150)">
      <!-- Outer flames -->
      <path d="M 0 100 Q -20 60 -10 30 Q 0 0 20 20 Q 40 -10 50 20 Q 70 0 60 30 Q 80 60 60 100 Z" 
            fill="url(#fireGradient)" opacity="0.8"/>
      <!-- Inner flames -->
      <path d="M 15 100 Q 10 70 20 50 Q 30 30 35 50 Q 45 30 40 60 Q 50 80 40 100 Z" 
            fill="#FCD34D" opacity="0.9"/>
    </g>
    
    <!-- AAC Block in center -->
    <g transform="translate(150, 180)">
      <!-- Block shadow -->
      <rect x="5" y="5" width="120" height="80" fill="rgba(0,0,0,0.3)"/>
      <!-- Main block -->
      <rect x="0" y="0" width="120" height="80" fill="#16A34A" opacity="0.4" stroke="url(#green6)" stroke-width="3"/>
      <!-- Block texture lines -->
      <line x1="0" y1="20" x2="120" y2="20" stroke="#22C55E" stroke-width="1" opacity="0.5"/>
      <line x1="0" y1="40" x2="120" y2="40" stroke="#22C55E" stroke-width="1" opacity="0.5"/>
      <line x1="0" y1="60" x2="120" y2="60" stroke="#22C55E" stroke-width="1" opacity="0.5"/>
      <!-- Fire resistant badge -->
      <circle cx="90" cy="20" r="15" fill="#16A34A" opacity="0.8"/>
      <text x="90" y="25" font-family="Arial" font-size="12" font-weight="bold" 
            fill="white" text-anchor="middle">4H</text>
    </g>
    
    <!-- Protection shield -->
    <g transform="translate(230, 140)">
      <path d="M 30 0 L 60 15 L 60 50 L 30 70 L 0 50 L 0 15 Z" 
            fill="none" stroke="#22C55E" stroke-width="3" opacity="0.6"/>
      <path d="M 30 15 L 45 25 L 45 45 L 30 55 L 15 45 L 15 25 Z" 
            fill="#16A34A" opacity="0.3"/>
    </g>
    
    <!-- Temperature gauge -->
    <g transform="translate(100, 280)">
      <rect x="0" y="0" width="200" height="30" fill="none" stroke="#22C55E" stroke-width="2" opacity="0.5"/>
      <rect x="5" y="5" width="190" height="20" fill="url(#fireGradient)" opacity="0.4"/>
      <text x="100" y="22" font-family="Arial" font-size="14" font-weight="bold" 
            fill="white" text-anchor="middle">1000°C</text>
    </g>
  </g>
  
  <!-- Text -->
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="32" font-weight="bold" 
        fill="white" text-anchor="middle">Fire Resistant</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" 
        fill="#22C55E" text-anchor="middle">Up to 4 Hours Protection</text>
</svg>