<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg4" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d0d0d;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="green4" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#16A34A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#22C55E;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="tempGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#EF4444;stop-opacity:0.8" />
      <stop offset="50%" style="stop-color:#F59E0B;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#3B82F6;stop-opacity:0.8" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="url(#bg4)"/>
  
  <!-- Building illustration -->
  <g transform="translate(250, 220)">
    <!-- House/Building -->
    <rect x="50" y="100" width="250" height="200" fill="none" stroke="url(#green4)" stroke-width="3"/>
    <!-- Roof -->
    <polygon points="50,100 175,30 300,100" fill="none" stroke="url(#green4)" stroke-width="3"/>
    <!-- Windows -->
    <rect x="80" y="140" width="60" height="60" fill="#16A34A" opacity="0.3" stroke="#22C55E" stroke-width="2"/>
    <rect x="210" y="140" width="60" height="60" fill="#16A34A" opacity="0.3" stroke="#22C55E" stroke-width="2"/>
    <!-- Door -->
    <rect x="150" y="240" width="50" height="60" fill="none" stroke="url(#green4)" stroke-width="2"/>
    
    <!-- Temperature arrows -->
    <g transform="translate(320, 120)">
      <!-- Summer (hot) - top -->
      <path d="M 30 0 L 30 40" stroke="#EF4444" stroke-width="3" marker-end="url(#arrowRed)"/>
      <text x="30" y="60" font-family="Arial" font-size="16" fill="#EF4444" text-anchor="middle">35°C</text>
    </g>
    
    <g transform="translate(320, 280)">
      <!-- Winter (cold) - bottom -->
      <path d="M 30 40 L 30 0" stroke="#3B82F6" stroke-width="3" marker-end="url(#arrowBlue)"/>
      <text x="30" y="60" font-family="Arial" font-size="16" fill="#3B82F6" text-anchor="middle">10°C</text>
    </g>
    
    <!-- Inside temperature indicator -->
    <text x="175" y="200" font-family="Arial" font-size="24" font-weight="bold" fill="#22C55E" text-anchor="middle">22°C</text>
  </g>
  
  <!-- Arrow markers -->
  <defs>
    <marker id="arrowRed" markerWidth="10" markerHeight="10" refX="5" refY="5" orient="auto">
      <path d="M 0 5 L 10 5 L 5 0 Z" fill="#EF4444"/>
    </marker>
    <marker id="arrowBlue" markerWidth="10" markerHeight="10" refX="5" refY="5" orient="auto">
      <path d="M 0 5 L 10 5 L 5 10 Z" fill="#3B82F6"/>
    </marker>
  </defs>
  
  <!-- Text -->
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="32" font-weight="bold" 
        fill="white" text-anchor="middle">Thermal Efficiency</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" 
        fill="#22C55E" text-anchor="middle">Comfort in Every Season</text>
</svg>