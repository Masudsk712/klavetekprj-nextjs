<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg3" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d0d0d;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="green3" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#16A34A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#22C55E;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="url(#bg3)"/>
  
  <!-- Construction site illustration -->
  <g transform="translate(150, 200)">
    <!-- Building outline -->
    <rect x="100" y="100" width="300" height="250" fill="none" stroke="url(#green3)" stroke-width="3"/>
    <!-- Floor lines -->
    <line x1="100" y1="160" x2="400" y2="160" stroke="#16A34A" stroke-width="2" opacity="0.5"/>
    <line x1="100" y1="220" x2="400" y2="220" stroke="#16A34A" stroke-width="2" opacity="0.5"/>
    <line x1="100" y1="280" x2="400" y2="280" stroke="#16A34A" stroke-width="2" opacity="0.5"/>
    
    <!-- AAC Blocks being placed -->
    <g transform="translate(180, 240)">
      <rect x="0" y="0" width="80" height="40" fill="#16A34A" opacity="0.6" stroke="#22C55E" stroke-width="2"/>
      <rect x="85" y="0" width="80" height="40" fill="#16A34A" opacity="0.6" stroke="#22C55E" stroke-width="2"/>
      <rect x="0" y="45" width="80" height="40" fill="#16A34A" opacity="0.6" stroke="#22C55E" stroke-width="2"/>
      <rect x="85" y="45" width="80" height="40" fill="#16A34A" opacity="0.6" stroke="#22C55E" stroke-width="2"/>
    </g>
    
    <!-- Speed lines -->
    <g opacity="0.4">
      <line x1="450" y1="150" x2="550" y2="150" stroke="#22C55E" stroke-width="2"/>
      <line x1="460" y1="180" x2="540" y2="180" stroke="#22C55E" stroke-width="2"/>
      <line x1="450" y1="210" x2="550" y2="210" stroke="#22C55E" stroke-width="2"/>
      <line x1="470" y1="240" x2="530" y2="240" stroke="#22C55E" stroke-width="2"/>
    </g>
    
    <!-- Arrow -->
    <polygon points="530,180 570,200 530,220" fill="#22C55E" opacity="0.6"/>
  </g>
  
  <!-- Text -->
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="32" font-weight="bold" 
        fill="white" text-anchor="middle">Faster Construction</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" 
        fill="#22C55E" text-anchor="middle">Lightweight & Efficient</text>
</svg>