<svg width="800" height="600" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg2" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a1a;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0d0d0d;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="green2" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#16A34A;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#22C55E;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="800" height="600" fill="url(#bg2)"/>
  
  <!-- Factory/Plant illustration -->
  <g transform="translate(250, 250)">
    <!-- Factory building -->
    <rect x="50" y="100" width="200" height="150" fill="none" stroke="url(#green2)" stroke-width="3"/>
    <!-- Roof -->
    <polygon points="50,100 150,50 250,100" fill="none" stroke="url(#green2)" stroke-width="3"/>
    <!-- Chimney 1 -->
    <rect x="80" y="40" width="30" height="60" fill="none" stroke="url(#green2)" stroke-width="3"/>
    <!-- Chimney 2 -->
    <rect x="170" y="30" width="30" height="70" fill="none" stroke="url(#green2)" stroke-width="3"/>
    <!-- Smoke/Eco waves -->
    <path d="M 95 30 Q 95 10 110 10 T 125 30" fill="none" stroke="#22C55E" stroke-width="2" opacity="0.6"/>
    <path d="M 185 20 Q 185 0 200 0 T 215 20" fill="none" stroke="#22C55E" stroke-width="2" opacity="0.6"/>
    <!-- Windows -->
    <rect x="70" y="130" width="40" height="40" fill="#16A34A" opacity="0.3"/>
    <rect x="130" y="130" width="40" height="40" fill="#16A34A" opacity="0.3"/>
    <rect x="190" y="130" width="40" height="40" fill="#16A34A" opacity="0.3"/>
    <!-- Door -->
    <rect x="130" y="200" width="40" height="50" fill="none" stroke="url(#green2)" stroke-width="2"/>
  </g>
  
  <!-- Leaf icon -->
  <g transform="translate(360, 180)">
    <path d="M 40 80 Q 40 40 80 20 Q 120 40 120 80 Q 80 60 40 80 Z" 
          fill="none" stroke="#22C55E" stroke-width="3"/>
    <line x1="80" y1="20" x2="80" y2="80" stroke="#22C55E" stroke-width="2"/>
  </g>
  
  <!-- Text -->
  <text x="400" y="520" font-family="Arial, sans-serif" font-size="32" font-weight="bold" 
        fill="white" text-anchor="middle">Eco-Friendly Production</text>
  <text x="400" y="560" font-family="Arial, sans-serif" font-size="18" 
        fill="#22C55E" text-anchor="middle">Sustainable Manufacturing</text>
</svg>