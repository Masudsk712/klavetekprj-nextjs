# Copy to `.env.local` for local development and fill in real values.
# NEVER commit real secrets. `.env.local` is gitignored.
#
# On Vercel, set these under Project -> Settings -> Environment Variables.
# The build no longer requires an API key at build time — it is read lazily at
# request time, so a missing key fails gracefully instead of crashing the build.

# Your Resend API key: https://resend.com/api-keys (canonical variable).
RESEND_API_KEY=

# Optional legacy alias. If set in addition to RESEND_API_KEY, RESEND_API_KEY
# takes priority. Kept so older `.env.local` files keep working unchanged.
# EMAIL_API_KEY=

# Verified sender. A fresh Resend free account can send from the default test
# domain `onboarding@resend.dev` (no domain verification required). Replace
# with your own verified sender (e.g. "Klavetek Website <hello@klavetek.com>").
EMAIL_FROM="Klavetek Website <onboarding@resend.dev>"

# Destination inbox for all contact + career enquiries.
EMAIL_TO=masudkac712@gmail.com